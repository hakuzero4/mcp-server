# Copy to .env and fill in locally. Do not commit .env.

# all = mount every service in one process (FastMCP namespace routing)
# nginxproxy = only that service
# nginxproxy,other = a subset
MCP_SERVER=all
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# nginxproxy
NPM_URL=http://127.0.0.1:81
NPM_EMAIL=
NPM_PASSWORD=
# NPM_TOKEN=
