# Copy to .env and fill in locally. Do not commit .env.

# all = mount every service in one process (FastMCP namespace routing)
# nginxproxy = only that service
# nginxproxy,other = a subset
MCP_SERVER=all
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# nginxproxy
NPM_URL=http://127.0.0.1:81
NPM_EMAIL=
NPM_PASSWORD=
# NPM_TOKEN=

# quarksave — same username and password as the WebUI login
QAS_URL=http://127.0.0.1:5005
QAS_USERNAME=
QAS_PASSWORD=

# tgchannel — user account from https://my.telegram.org (not a bot token)
# Session string is printed by: uv run python -m tgchannel.login
TG_API_ID=
TG_API_HASH=
TG_SESSION=
# Saved channel posts. Empty disables only tgchannel_save_messages and the saved-post tools.
# Local uv: TG_STORE_PATH=data/tgchannel.sqlite
# Compose always uses /data/tgchannel.sqlite inside the container.
TG_STORE_PATH=
