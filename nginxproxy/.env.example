# Nginx Proxy Manager admin URL. `/api` is added automatically if missing.
NPM_URL=http://127.0.0.1:81

# Login used to request a JWT (POST /api/tokens).
NPM_EMAIL=
NPM_PASSWORD=

# Optional pre-issued Bearer token. Credentials are used if it expires.
# NPM_TOKEN=

# HTTP timeouts in seconds.
# NPM_TIMEOUT=30
# NPM_CERT_TIMEOUT=900
